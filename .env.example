# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where contact-form enquiries are POSTed as JSON (CRM, Zapier/Make, Slack
# workflow, email service webhook...). Required in production: without it the
# form reports an error instead of silently dropping enquiries.
CONTACT_WEBHOOK_URL=

# Optional Google Analytics 4 measurement ID (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
